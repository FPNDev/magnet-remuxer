PORT=3000
LOG_LEVEL=info
FFMPEG_PATH=ffmpeg

# Pieces, playlists and segments. Defaults to <tmp>/magnet-cache
#CACHE_DIR=/var/cache/magnet-remuxer

# Disk budgets. These two together are the server's ceiling on disk, and they
# are a promise it keeps: if the drive runs out anyway, WebTorrent throws
# ENOSPC and destroys the torrent mid-playback, which looks just like a stall.
# 8192 + 15360 is 23 GiB.
PIECE_CACHE_MB=8192
SEGMENT_CACHE_MB=15360

# Target segment length in seconds; real segments follow keyframes. A seek
# downloads a whole segment before its first frame, so shorter is faster to
# start; playback speed does not change. Changing it re-renders cached files.
SEGMENT_DURATION=2

# Segments rendered ahead of the player, and a cap on that in bytes read
PREFETCH_SEGMENTS=9
PREFETCH_AHEAD_MB=96

# Concurrent ffmpeg jobs across all torrents. Defaults to max(16, cpu count):
# jobs mostly wait on the swarm rather than on CPU, so more than one per core is
# reasonable.
MAX_CONCURRENT_JOBS=16

# Concurrent jobs reading one torrent. Reads of the same torrent divide its
# bandwidth rather than adding to it, so a higher number only spreads the same
# bytes more thinly - and leaves stale prefetch competing with a seek.
# 2-4 is a sweet spot
MAX_JOBS_PER_TORRENT=2

# A request waiting longer than this fails with 504.
REQUEST_TIMEOUT_S=120
# Hard limit for one segment job.
JOB_TIMEOUT_S=180
# Fail a read when the *torrent* receives nothing for this long.
READ_STALL_S=45
# How long to wait for torrent metadata.
METADATA_TIMEOUT_S=90
# Remove torrents unused for this long.
TORRENT_IDLE_S=600
