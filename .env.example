HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
FFMPEG_PATH=ffmpeg

# Where pieces, playlists and segments are stored. Defaults to
# <tmp>/magnet-cache.
#CACHE_DIR=/var/cache/magnet-remuxer

# Disk budgets for downloaded pieces and rendered segments. Both live in one
# cache, evicted least recently used first.
PIECE_CACHE_MB=8192
SEGMENT_CACHE_MB=15360
# Budget for playlists, media indexes, init sections, torrent metadata and
# remembered or banned peers.
METADATA_CACHE_MB=2048
# Ceiling for the whole cache directory, measured on disk rather than summed
# from the budgets above. Empty means those three budgets alone.
#CACHE_TOTAL_MB=409600
# How often disk usage is measured against that ceiling.
CACHE_SWEEP_MINUTES=5

# Target segment length in seconds; real segments end on a keyframe. Shorter
# segments start faster after a seek, and changing this re-renders cached
# segments.
SEGMENT_DURATION=2

# Keeps torrent "warm" by prefetching next segment. Dropped if not
# requested in KEEP_WARM_S seconds. Prevents speed drops between chunks / on seeking
# 0 = disalbed
KEEP_WARM_S=5
# Segments rendered when GET /warm readies a title before playback. 0 warms
# the index and playlists alone.
WARM_SEGMENTS=2
# Titles warmed at the same time.
WARM_CONCURRENCY=4

# Concurrent ffmpeg jobs across all torrents. Unset means max(16, cpu count),
# since jobs spend most of their time waiting on the swarm rather than on CPU.
#MAX_CONCURRENT_JOBS=64

# A request waiting longer than this fails with 504.
REQUEST_TIMEOUT_S=120
# Hard limit on one segment job.
JOB_TIMEOUT_S=180
# Fail a read when the torrent receives no data for this long.
READ_STALL_S=45
# Connections held per torrent; further peers wait in a queue for a slot.
MAX_PEERS=100

# Ask a second peer for the block a reader is stopped at, and use whichever
# copy arrives first.
TAIL_HEDGE=1
# How long that block waits before a second peer is asked.
TAIL_HEDGE_MS=250

# Drop peers that hold none of what is being read, or that answer nothing,
# while other peers wait for a connection slot.
PEER_CHURN=1
# How long a new connection has to prove itself. A peer that holds none of
# what is being read is dropped sooner.
PEER_CHURN_GRACE_S=10

# Ban peers whose data fails verification.
BAN_CORRUPT_PEERS=1
# How long such a ban lasts. Bans are stored on disk and survive a restart.
PEER_BAN_DAYS=7

# How long to wait for torrent metadata.
METADATA_TIMEOUT_S=90
# Remove torrents unused for this long.
TORRENT_IDLE_S=600
